# Copy to .env and adjust. Never commit .env — it can hold API keys.

# ---- Core -----------------------------------------------------------------
# For running the backend on your machine against the compose "db" service.
# docker-compose.yml overrides this inside the app container.
DATABASE_URL=postgresql+psycopg://servicesaathi:servicesaathi-local@localhost:5432/servicesaathi
# Signs login tokens. Change it to a long random string outside local demos.
APP_SECRET=change-me-local-demo-secret
POSTGRES_PASSWORD=servicesaathi-local

# ---- Hosted LLM (optional) -------------------------------------------------
# none | anthropic | openai | openai_compatible
# With "none" the app uses rules-based extraction and retrieval-only policy excerpts.
LLM_PROVIDER=none
# A model name your account can use, e.g. claude-sonnet-5-5 for Anthropic.
LLM_MODEL=
LLM_API_KEY=
# Only for openai_compatible (e.g. a self-hosted server exposing /chat/completions)
LLM_BASE_URL=
# Optional: USD per million tokens, used ONLY for a clearly labelled cost estimate in Developer Mode.
LLM_INPUT_PRICE_PER_MTOK=
LLM_OUTPUT_PRICE_PER_MTOK=

# ---- Embeddings ------------------------------------------------------------
# hashing = built-in, no download, lexical (default)
# local   = sentence-transformers on this machine; ONE-TIME ~90 MB model download
#           (pip install -r backend/requirements-local-embeddings.txt)
# openai  = hosted embeddings API (uses EMBEDDING_API_KEY, or LLM_API_KEY if empty)
EMBEDDING_PROVIDER=hashing
EMBEDDING_MODEL=
EMBEDDING_API_KEY=
EMBEDDING_BASE_URL=
# After changing EMBEDDING_PROVIDER, re-ingest documents (Admin → Policy documents, or
# `python -m app.services.rag.reingest`) and re-tune the threshold below.
RAG_MIN_SIMILARITY=0.20
RAG_TOP_K=4
